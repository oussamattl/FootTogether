<?xml version="1.0" encoding="utf-8"?>
<!-- Couleur des icônes et textes de la barre du bas : vert si l'onglet est sélectionné, gris sinon.
     (un "selector" choisit une couleur selon l'état de la vue) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/green_primary" android:state_checked="true" />
    <item android:color="@color/text_muted" />
</selector>
