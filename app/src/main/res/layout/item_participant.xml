<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de la liste des participants : initiale dans un rond, pseudo, poste · niveau,
     et l'étiquette ORGANISATEUR pour celui qui a créé le match. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="@dimen/space_m">

    <!-- Initiale, recouverte par la miniature de la photo quand le joueur en a une -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <TextView
            android:id="@+id/participant_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="O" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/participant_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FootTogether.Circle" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/participant_pseudo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Oussama" />

        <TextView
            android:id="@+id/participant_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            tools:text="Attaquant · Confirmé" />
    </LinearLayout>

    <TextView
        android:id="@+id/participant_organizer"
        style="@style/Widget.FootTogether.SmallChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/ink"
        android:text="@string/participant_organizer"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
