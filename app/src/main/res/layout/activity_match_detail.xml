<?xml version="1.0" encoding="utf-8"?>
<!-- Détail d'un match, d'après la maquette :
     en-tête « terrain » fixe, contenu qui défile (infos + participants),
     barre du bas fixe avec les places restantes et le bouton Rejoindre / Quitter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.detail.MatchDetailActivity">

    <!-- ===== En-tête : terrain + boutons Retour et Favori ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_pitch" />

        <LinearLayout
            android:id="@+id/detail_header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_back"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/action_back"
                app:backgroundTint="@color/white"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/ink" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Favori : enregistré dans SQLite (FavoritesDao) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_favorite"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/action_favorite"
                app:backgroundTint="@color/white"
                app:icon="@drawable/ic_favorite_border"
                app:iconTint="@color/green_primary" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Contenu qui défile. Marge négative : la feuille arrondie chevauche le terrain ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_detail_sheet">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Chargement (avant la première réponse de Firestore) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/detail_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xxl"
                android:indeterminate="true"
                app:indicatorColor="@color/green_primary" />

            <LinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Badge format + étiquettes niveau et état -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_format"
                        style="@style/Widget.FootTogether.FormatBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="5 VS 5" />

                    <TextView
                        android:id="@+id/detail_level"
                        style="@style/Widget.FootTogether.SmallChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        tools:text="Intermédiaire" />

                    <TextView
                        android:id="@+id/detail_status"
                        style="@style/Widget.FootTogether.SmallChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        tools:text="Ouvert" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:fontFamily="@font/barlow_condensed"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="Foot à 5 du samedi" />

                <!-- Carte d'infos : date, lieu, description -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FootTogether.MatchCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_l"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/detail_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_event"
                            app:drawableTint="@color/green_primary"
                            tools:text="Samedi 28 nov. · 15:00" />

                        <!-- Lieu + distance (si la position est connue) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/detail_place"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawablePadding="10dp"
                                android:gravity="center_vertical"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                app:drawableStartCompat="@drawable/ic_place"
                                app:drawableTint="@color/green_primary"
                                tools:text="City stade, Valenciennes" />

                            <TextView
                                android:id="@+id/detail_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="1,2 km"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <!-- Météo prévue (Open-Meteo, appel HTTP) -->
                        <TextView
                            android:id="@+id/detail_weather"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_cloud"
                            app:drawableTint="@color/green_primary"
                            tools:text="Météo prévue : 12 °C · Pluie"
                            tools:visibility="visible" />

                        <!-- Infos complémentaires (si l'organisateur en a écrit) -->
                        <TextView
                            android:id="@+id/detail_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp"
                            android:visibility="gone"
                            tools:text="Prévoir des chasubles."
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Titre de section + compteur « 2 / 10 » -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/barlow_condensed"
                        android:text="@string/detail_participants"
                        android:textAllCaps="true"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="2 / 10" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/detail_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    app:indicatorColor="@color/green_primary"
                    app:trackColor="@color/segmented_bg"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="8dp"
                    tools:max="10"
                    tools:progress="2" />

                <!-- Liste des participants (mise à jour en temps réel) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FootTogether.MatchCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    app:cardCornerRadius="16dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/detail_participants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_participant" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bandeau hors ligne (lot 6) : les boutons sont alors désactivés -->
    <TextView
        android:id="@+id/detail_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warning_bg"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_s"
        android:text="@string/offline_banner"
        android:textColor="@color/warning_text"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- ===== Barre du bas : places restantes + action ===== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <LinearLayout
        android:id="@+id/detail_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_places_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed"
                android:textColor="@color/on_green_soft"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="8" />

            <TextView
                android:id="@+id/detail_places_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="places restantes" />
        </LinearLayout>

        <!-- Organisateur seulement : modifier le match -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_edit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:minHeight="54dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_edit_match"
            android:textColor="@color/text_primary"
            android:visibility="gone"
            app:cornerRadius="14dp"
            app:strokeColor="@color/outline"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_action"
            style="@style/Widget.FootTogether.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:enabled="false"
            tools:text="Rejoindre le match" />
    </LinearLayout>
</LinearLayout>
