<?xml version="1.0" encoding="utf-8"?>
<!-- Rechercher : ville, bascule liste / carte, filtres repliables, puis la liste ou la carte. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Ville + bascule liste / carte -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_l">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/search_city_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search_city_hint"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/search_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            app:checkedButton="@id/search_mode_list"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_mode_list"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:contentDescription="@string/search_mode_list"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_list"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_mode_map"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:contentDescription="@string/search_mode_map"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_map"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- Bouton Filtres + nombre de résultats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_filters_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:textColor="@color/green_primary"
            app:icon="@drawable/ic_tune"
            app:iconTint="@color/green_primary"
            tools:text="Filtres (2)" />

        <TextView
            android:id="@+id/search_result_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            tools:text="3 matchs" />
    </LinearLayout>

    <!-- ===== Filtres (repliables) : une ligne de chips qui défile par catégorie ===== -->
    <LinearLayout
        android:id="@+id/search_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Distance (nécessite la localisation) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_l"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/search_distance_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/search_distance_all"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_distance_all"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_distance_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_distance_5"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_distance_5" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_distance_10"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_distance_10" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_distance_25"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_distance_25" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Date -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_l"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/search_date_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/search_date_all"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_date_all"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_date_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_date_today"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_date_today" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_date_weekend"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_date_weekend" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_date_week"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_date_week" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Format -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_l"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/search_format_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/search_format_all"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_format_all"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_format_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_format_five"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/format_five" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_format_seven"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/format_seven" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_format_eleven"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/format_eleven" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Niveau + places disponibles -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_l"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/search_places"
                    style="@style/Widget.FootTogether.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s"
                    android:checkable="true"
                    android:text="@string/filter_places" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/search_level_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedChip="@id/search_level_all"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/search_level_all"
                        style="@style/Widget.FootTogether.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_level_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/search_level_beginner"
                        style="@style/Widget.FootTogether.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/level_beginner" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/search_level_intermediate"
                        style="@style/Widget.FootTogether.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/level_intermediate" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/search_level_advanced"
                        style="@style/Widget.FootTogether.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/level_advanced" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Localisation refusée : on l'explique et on propose de réessayer -->
    <LinearLayout
        android:id="@+id/search_location_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_chip_small"
        android:backgroundTint="@color/warning_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/location_denied_search"
            android:textColor="@color/warning_text"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_location_allow"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/location_allow"
            android:textColor="@color/warning_text" />
    </LinearLayout>

    <!-- ===== Résultats : liste OU carte ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingBottom="@dimen/space_xl"
            tools:listitem="@layout/item_match" />

        <!-- Carte OpenStreetMap (osmdroid) : glisser pour se déplacer, pincer pour zoomer -->
        <org.osmdroid.views.MapView
            android:id="@+id/search_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_xxl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_place"
                app:tint="@color/green_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/search_empty_title"
                android:textAppearance="@style/TextAppearance.FootTogether.Title"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/search_empty_message"
                android:textAppearance="@style/TextAppearance.FootTogether.Body"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
