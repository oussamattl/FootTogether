<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-jeu « Jongles » : secouer le téléphone (accéléromètre) fait jongler le ballon pendant 30 s. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/game_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/minigame_title"
        app:titleTextAppearance="@style/TextAppearance.FootTogether.Title"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/form_side_padding"
            android:paddingBottom="@dimen/space_xl">

            <!-- Temps restant et score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FootTogether.MatchCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/game_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed"
                            android:textColor="@color/text_primary"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            tools:text="30" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/minigame_seconds"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FootTogether.MatchCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/game_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed"
                            android:textColor="@color/green_primary"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            tools:text="12" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/minigame_juggles"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Le ballon : il saute à chaque jongle. On peut aussi le toucher (repli sans capteur) -->
            <ImageView
                android:id="@+id/game_ball"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/minigame_ball"
                android:src="@drawable/ic_ball" />

            <TextView
                android:id="@+id/game_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                tools:text="@string/minigame_instructions" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_start"
                style="@style/Widget.FootTogether.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/minigame_start" />

            <TextView
                android:id="@+id/game_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text="Record : 18 jongles" />

            <TextView
                android:id="@+id/game_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.FootTogether.Caption"
                tools:text="Dernières parties : 12 · 8 · 15" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
