<?xml version="1.0" encoding="utf-8"?>
<!-- Formulaire « Créer un match », d'après la maquette. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/form_side_padding"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/form_side_padding"
        android:paddingBottom="@dimen/space_xl">

        <!-- Titre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/create_title_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_title"
            app:counterEnabled="true"
            app:counterMaxLength="60">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/create_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date et heure côte à côte : toucher le champ ouvre un sélecteur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/create_date_layout"
                style="@style/Widget.FootTogether.TextField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:hint="@string/field_date"
                app:startIconDrawable="@drawable/ic_event">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/create_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/create_time_layout"
                style="@style/Widget.FootTogether.TextField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:hint="@string/field_time"
                app:startIconDrawable="@drawable/ic_schedule">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/create_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Lieu du terrain -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/create_address_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/field_address"
            app:startIconDrawable="@drawable/ic_place">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/create_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPostalAddress|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/create_city_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/field_city">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/create_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Lot 5 : sinon l'adresse saisie est convertie en coordonnées (Geocoder) à la publication -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_use_location"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/use_my_location"
                android:textColor="@color/green_primary"
                app:icon="@drawable/ic_my_location"
                app:iconTint="@color/green_primary" />

            <TextView
                android:id="@+id/create_location_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/location_saved"
                android:textColor="@color/on_green_soft"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Format : un seul choix possible (singleSelection) et obligatoire (selectionRequired) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/field_format"
            android:textAppearance="@style/TextAppearance.FootTogether.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/create_format_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:checkedChip="@id/create_format_five"
            app:chipSpacingHorizontal="@dimen/space_s"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/create_format_five"
                style="@style/Widget.FootTogether.Chip.Format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format_five" />

            <com.google.android.material.chip.Chip
                android:id="@+id/create_format_seven"
                style="@style/Widget.FootTogether.Chip.Format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format_seven" />

            <com.google.android.material.chip.Chip
                android:id="@+id/create_format_eleven"
                style="@style/Widget.FootTogether.Chip.Format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format_eleven" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Nombre de joueurs maximum avec boutons − et + -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FootTogether.MatchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/space_s">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/field_max_players"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/create_players_minus"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/bg_stepper_button"
                    android:contentDescription="@string/decrease_players"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/create_players_count"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/create_players_plus"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/bg_stepper_button"
                    android:contentDescription="@string/increase_players"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Niveau recherché -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/field_level"
            android:textAppearance="@style/TextAppearance.FootTogether.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/create_level_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:checkedChip="@id/create_level_intermediate"
            app:chipSpacingHorizontal="@dimen/space_s"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/create_level_beginner"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_beginner" />

            <com.google.android.material.chip.Chip
                android:id="@+id/create_level_intermediate"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_intermediate" />

            <com.google.android.material.chip.Chip
                android:id="@+id/create_level_advanced"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_advanced" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Description optionnelle -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/create_description_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:hint="@string/field_description"
            app:placeholderText="@string/hint_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/create_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_publish"
                style="@style/Widget.FootTogether.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_publish" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/create_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/white"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
