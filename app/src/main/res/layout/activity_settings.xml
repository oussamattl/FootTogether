<?xml version="1.0" encoding="utf-8"?>
<!-- Paramètres : réglages enregistrés dans SharedPreferences (AppPrefs). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/menu_settings"
        app:titleTextAppearance="@style/TextAppearance.FootTogether.Title"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_xl">

            <!-- ===== Apparence ===== -->
            <TextView
                style="@style/TextAppearance.FootTogether.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/settings_section_appearance"
                android:textColor="@color/text_muted" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FootTogether.MatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/settings_language"
                        layout="@layout/view_setting_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline" />

                    <include
                        android:id="@+id/settings_theme"
                        layout="@layout/view_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Recherche ===== -->
            <TextView
                style="@style/TextAppearance.FootTogether.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/settings_section_search"
                android:textColor="@color/text_muted" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FootTogether.MatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/settings_city"
                    layout="@layout/view_setting_row" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Notifications ===== -->
            <TextView
                style="@style/TextAppearance.FootTogether.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/settings_section_notifications"
                android:textColor="@color/text_muted" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FootTogether.MatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/settings_reminder"
                        layout="@layout/view_setting_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline" />

                    <include
                        android:id="@+id/settings_system_notifications"
                        layout="@layout/view_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== À propos ===== -->
            <TextView
                android:id="@+id/settings_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.FootTogether.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
