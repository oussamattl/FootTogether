<?xml version="1.0" encoding="utf-8"?>
<!-- Accueil : salutation, titre de section, liste des matchs à venir.
     SwipeRefreshLayout = « tirer vers le bas pour actualiser ». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Salutation -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="@string/home_greeting"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/home_pseudo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/barlow_condensed"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold"
        tools:text="Mehdi" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/home_section_upcoming"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.FootTogether.Title"
        android:textColor="@color/text_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/home_swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_xl"
                tools:listitem="@layout/item_match" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Premier chargement -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/home_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/green_primary" />

        <!-- État vide illustré -->
        <LinearLayout
            android:id="@+id/home_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_xxl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_event"
                app:tint="@color/green_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/home_empty_title"
                android:textAppearance="@style/TextAppearance.FootTogether.Title"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/home_empty_message"
                android:textAppearance="@style/TextAppearance.FootTogether.Body"
                android:textColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_empty_create"
                style="@style/Widget.FootTogether.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:paddingStart="@dimen/space_xl"
                android:paddingEnd="@dimen/space_xl"
                android:text="@string/home_empty_action" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
