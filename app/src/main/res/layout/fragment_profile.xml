<?xml version="1.0" encoding="utf-8"?>
<!-- Profil, d'après la maquette : en-tête foncé (photo, pseudo, ville, poste, niveau),
     compteurs, coordonnées et bouton « Modifier le profil ». -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== En-tête ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="28dp">

            <!-- Photo (ou initiale) + bouton appareil photo posé dessus -->
            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="108dp">

                <FrameLayout
                    android:layout_width="102dp"
                    android:layout_height="102dp"
                    android:background="@drawable/bg_avatar_ring"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar"
                        android:backgroundTint="@color/green_soft"
                        android:fontFamily="@font/barlow_condensed"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/on_green_soft"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        tools:text="M" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_photo_description"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.FootTogether.Circle" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_photo_button"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@string/profile_change_photo"
                    app:backgroundTint="@color/lime_accent"
                    app:icon="@drawable/ic_photo_camera"
                    app:iconSize="20dp"
                    app:iconTint="@color/ink"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="3dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/profile_pseudo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:fontFamily="@font/barlow_condensed"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="Mehdi" />

            <TextView
                android:id="@+id/profile_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_ink_muted"
                android:textSize="14sp"
                tools:text="Valenciennes" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profile_position"
                    style="@style/Widget.FootTogether.SmallChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/lime_accent"
                    android:textColor="@color/ink"
                    tools:text="Milieu" />

                <TextView
                    android:id="@+id/profile_level"
                    style="@style/Widget.FootTogether.SmallChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:backgroundTint="@color/ink_surface"
                    android:textColor="@color/white"
                    tools:text="Intermédiaire" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Contenu ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Compteurs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FootTogether.MatchCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/profile_played"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed"
                            android:textColor="@color/text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="12" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_played"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FootTogether.MatchCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/profile_organized"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed"
                            android:textColor="@color/text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_organized"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Nom et e-mail -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FootTogether.MatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_person"
                        app:drawableTint="@color/green_primary"
                        tools:text="Mehdi B." />

                    <TextView
                        android:id="@+id/profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp"
                        tools:text="mehdi@exemple.com" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Badges et avis reçus (lot 9) ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/badges_title"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.FootTogether.Title"
                android:textColor="@color/text_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FootTogether.MatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_xs">

                    <include
                        android:id="@+id/profile_badge_regular"
                        layout="@layout/view_badge_row" />

                    <include
                        android:id="@+id/profile_badge_organizer"
                        layout="@layout/view_badge_row" />

                    <include
                        android:id="@+id/profile_badge_fair_play"
                        layout="@layout/view_badge_row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_xs"
                        android:background="@color/outline" />

                    <!-- Moyennes des évaluations reçues après les matchs -->
                    <TextView
                        android:id="@+id/profile_ratings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_l"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp"
                        tools:text="Fair-play 4,5 · Ponctualité 4,0 · Esprit d’équipe 5,0 (3 avis)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Classement et mini-jeu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_leaderboard"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:minHeight="54dp"
                    android:text="@string/leaderboard_title"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_minigame"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:minHeight="54dp"
                    android:text="@string/minigame_short"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/outline" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_edit"
                style="@style/Widget.FootTogether.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/profile_edit"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
