<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de réglage : titre + valeur actuelle en dessous. Toute la ligne est cliquable.
     Réutilisée plusieurs fois dans activity_settings.xml avec <include>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_m">

    <TextView
        android:id="@+id/setting_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        tools:text="Langue" />

    <TextView
        android:id="@+id/setting_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption"
        tools:text="Comme le téléphone" />
</LinearLayout>
