<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'authentification : en-tête vert + sélecteur Connexion / Inscription
     + un conteneur dans lequel on affiche LoginFragment ou RegisterFragment.
     NestedScrollView : l'écran défile quand le clavier est ouvert. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.auth.AuthActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tête vert -->
        <LinearLayout
            android:id="@+id/auth_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_header"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="@dimen/auth_header_padding_top"
            android:paddingEnd="28dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/barlow_condensed"
                android:text="@string/auth_login_title"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auth_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/auth_login_subtitle"
                android:textColor="#E3F2E8"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/auth_side_padding"
            android:paddingVertical="28dp">

            <!-- Sélecteur à deux onglets, style "segmenté" de la maquette -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/auth_tabs"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_segmented"
                android:padding="4dp"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/bg_segmented_indicator"
                app:tabIndicatorColor="@color/surface"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorGravity="stretch"
                app:tabMode="fixed"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/text_primary"
                app:tabTextAppearance="@style/TextAppearance.FootTogether.Tab"
                app:tabTextColor="@color/text_muted" />

            <!-- Ici s'affiche le fragment de l'onglet sélectionné -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/auth_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
