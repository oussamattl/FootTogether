<?xml version="1.0" encoding="utf-8"?>
<!-- Feuille qui monte du bas (BottomSheet) pour modifier son profil. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed"
            android:text="@string/profile_edit"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_pseudo_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/field_pseudo"
            app:counterEnabled="true"
            app:counterMaxLength="20">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_pseudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_name_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:hint="@string/field_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_city_layout"
            style="@style/Widget.FootTogether.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/field_city">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/field_position"
            android:textAppearance="@style/TextAppearance.FootTogether.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/edit_position_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:chipSpacingHorizontal="@dimen/space_s"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/edit_position_goalkeeper"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/position_goalkeeper" />

            <com.google.android.material.chip.Chip
                android:id="@+id/edit_position_defender"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/position_defender" />

            <com.google.android.material.chip.Chip
                android:id="@+id/edit_position_midfielder"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/position_midfielder" />

            <com.google.android.material.chip.Chip
                android:id="@+id/edit_position_forward"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/position_forward" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/field_my_level"
            android:textAppearance="@style/TextAppearance.FootTogether.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/edit_level_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:chipSpacingHorizontal="@dimen/space_s"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/edit_level_beginner"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_beginner" />

            <com.google.android.material.chip.Chip
                android:id="@+id/edit_level_intermediate"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_intermediate" />

            <com.google.android.material.chip.Chip
                android:id="@+id/edit_level_advanced"
                style="@style/Widget.FootTogether.Chip.Level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_advanced" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_save"
            style="@style/Widget.FootTogether.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
