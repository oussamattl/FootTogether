<?xml version="1.0" encoding="utf-8"?>
<!-- Écran principal : barre du haut (MaterialToolbar), zone des fragments au milieu,
     barre de navigation du bas, et bouton rond "+" posé au centre de cette barre. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.main.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextAppearance="@style/TextAppearance.FootTogether.Title"
        app:titleTextColor="@color/text_primary" />

    <!-- Bandeau hors ligne (lot 6) : affiché par NetworkMonitor quand le réseau disparaît -->
    <TextView
        android:id="@+id/main_offline_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/warning_bg"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_s"
        android:text="@string/offline_banner"
        android:textColor="@color/warning_text"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible" />

    <!-- Zone où MainActivity affiche le fragment de l'onglet choisi -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_offline_banner" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav" />

    <!-- Bouton central "Créer" : rond, vert, centré sur le bord haut de la barre du bas -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/nav_create_description"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/green_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_nav"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FootTogether.Circle"
        app:tint="@color/white" />
</androidx.constraintlayout.widget.ConstraintLayout>
