<?xml version="1.0" encoding="utf-8"?>
<!-- Favoris et matchs vus récemment : lus dans SQLite (fonctionne sans réseau). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favorites_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/favorites_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:minHeight="?attr/actionBarSize"
        app:menu="@menu/menu_favorites"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/menu_favorites"
        app:titleTextAppearance="@style/TextAppearance.FootTogether.Title"
        app:titleTextColor="@color/text_primary" />

    <!-- Onglets segmentés, même style que « Mes matchs » -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/favorites_tabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_segmented"
        android:padding="4dp"
        app:tabGravity="fill"
        app:tabIndicator="@drawable/bg_segmented_indicator"
        app:tabIndicatorColor="@color/surface"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextAppearance="@style/TextAppearance.FootTogether.Tab"
        app:tabTextColor="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/favorites_offline_hint"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favorites_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xl"
            tools:listitem="@layout/item_match" />

        <LinearLayout
            android:id="@+id/favorites_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_xxl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/favorites_empty_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/green_primary" />

            <TextView
                android:id="@+id/favorites_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.FootTogether.Title"
                android:textColor="@color/text_primary"
                tools:text="Aucun favori" />

            <TextView
                android:id="@+id/favorites_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.FootTogether.Body"
                android:textColor="@color/text_muted"
                tools:text="Touche le cœur d’un match pour le retrouver ici." />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
