<?xml version="1.0" encoding="utf-8"?>
<!-- Famille de police Barlow Condensed (licence SIL Open Font License) :
     titres, badges "5 VS 5" et chiffres. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/barlow_condensed_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/barlow_condensed_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/barlow_condensed_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/barlow_condensed_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
