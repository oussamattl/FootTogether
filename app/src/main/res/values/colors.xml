<?xml version="1.0" encoding="utf-8"?>
<!-- Palette de la maquette FootTogether (mode clair).
     Les couleurs "de surface" (background, surface, text_primary...) sont redéfinies
     dans values-night/colors.xml pour le mode sombre : Android choisit le bon fichier tout seul. -->
<resources>
    <!-- Couleurs de marque : identiques en clair et en sombre -->
    <color name="green_primary">#0F7A3D</color>
    <color name="green_dark">#0A5A2C</color>
    <color name="ink">#10201A</color>
    <color name="lime_accent">#C6F432</color>
    <color name="white">#FFFFFF</color>

    <!-- États des matchs -->
    <color name="warning_bg">#FEF3C7</color>
    <color name="warning_text">#92400E</color>
    <color name="error_bg">#FEE4E2</color>
    <color name="error_text">#912018</color>
    <color name="progress_full">#B45309</color>
    <color name="neutral_chip_bg">#E7EAE6</color>

    <!-- En-tête foncé du Profil (identique en clair et en sombre) -->
    <color name="ink_surface">#1F3329</color>
    <color name="on_ink_muted">#B9C7BF</color>

    <!-- Couleurs qui changent en mode sombre -->
    <color name="background">#F4F6F2</color>
    <color name="surface">#FFFFFF</color>
    <color name="outline">#DDE3DC</color>
    <color name="text_primary">#10201A</color>
    <color name="text_muted">#52625A</color>
    <color name="green_soft">#E3F2E8</color>
    <color name="on_green_soft">#0A5A2C</color>
    <color name="segmented_bg">#E6EBE5</color>
</resources>
