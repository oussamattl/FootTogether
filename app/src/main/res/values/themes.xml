<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème de base de l'application : Material 3, sans barre d'action
         (on utilisera une MaterialToolbar placée dans chaque écran). -->
    <style name="Base.Theme.FootTogether" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Couleurs principales (boutons, champs actifs, liens) -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_soft</item>
        <item name="colorOnPrimaryContainer">@color/on_green_soft</item>
        <item name="colorSecondary">@color/green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/green_soft</item>
        <item name="colorOnSecondaryContainer">@color/on_green_soft</item>
        <item name="colorTertiary">@color/lime_accent</item>
        <item name="colorOnTertiary">@color/ink</item>

        <!-- Fonds et textes -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error_text</item>
        <item name="colorErrorContainer">@color/error_bg</item>

        <!-- Police par défaut : Inter -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <!-- Styles de texte Material 3 : titres en Barlow Condensed, le reste en Inter -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.FootTogether.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.FootTogether.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.FootTogether.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.FootTogether.Title</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.FootTogether.Button</item>

        <!-- Barre d'état : icônes sombres sur fond clair -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FootTogether" parent="Base.Theme.FootTogether" />

    <!-- ===== Styles de texte réutilisables ===== -->

    <!-- Grand titre en majuscules (ex. "FOOTTOGETHER", "MES MATCHS") -->
    <style name="TextAppearance.FootTogether.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/barlow_condensed</item>
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/text_headline</item>
    </style>

    <!-- Titre de section ou de carte -->
    <style name="TextAppearance.FootTogether.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/barlow_condensed</item>
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <!-- Texte courant -->
    <style name="TextAppearance.FootTogether.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Texte secondaire, plus petit et grisé -->
    <style name="TextAppearance.FootTogether.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Texte des boutons -->
    <style name="TextAppearance.FootTogether.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Badge de format "5 VS 5" : Barlow Condensed, lime sur fond ink -->
    <style name="Widget.FootTogether.FormatBadge" parent="">
        <item name="android:background">@drawable/bg_format_badge</item>
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/lime_accent</item>
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_xxs</item>
        <item name="android:paddingBottom">@dimen/space_xxs</item>
    </style>

    <!-- Thème de l'écran de démarrage : fond vert dès le lancement (pas de flash blanc) -->
    <style name="Theme.FootTogether.Splash" parent="Theme.FootTogether">
        <item name="android:windowBackground">@color/green_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Champ de saisie : contour arrondi 14dp, fond blanc -->
    <style name="Widget.FootTogether.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/green_primary</item>
    </style>

    <!-- Bouton principal vert, haut de 54dp, coins 14dp -->
    <style name="Widget.FootTogether.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Texte des onglets Connexion / Inscription -->
    <style name="TextAppearance.FootTogether.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Bouton de choix (base) : chip sans coche, bordure fine -->
    <style name="Widget.FootTogether.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">46dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Choix du format : ink + lime quand sélectionné, police Barlow Condensed -->
    <style name="Widget.FootTogether.Chip.Format" parent="Widget.FootTogether.Chip.Choice">
        <item name="chipCornerRadius">12dp</item>
        <item name="chipBackgroundColor">@color/chip_format_bg</item>
        <item name="android:textColor">@color/chip_format_text</item>
        <item name="android:textAppearance">@style/TextAppearance.FootTogether.ChipFormat</item>
    </style>

    <!-- Choix du niveau : vert + blanc quand sélectionné, forme pilule -->
    <style name="Widget.FootTogether.Chip.Level" parent="Widget.FootTogether.Chip.Choice">
        <item name="chipCornerRadius">21dp</item>
        <item name="chipBackgroundColor">@color/chip_level_bg</item>
        <item name="android:textColor">@color/chip_level_text</item>
        <item name="android:textAppearance">@style/TextAppearance.FootTogether.Button</item>
    </style>

    <!-- Filtres de la recherche : même look que le niveau, en plus compact
         (la zone tactile reste de 48dp grâce à Material) -->
    <style name="Widget.FootTogether.Chip.Filter" parent="Widget.FootTogether.Chip.Level">
        <item name="chipMinHeight">38dp</item>
        <item name="chipCornerRadius">19dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.FootTogether.ChipFormat" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/barlow_condensed</item>
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Petit libellé gras au-dessus d'un groupe de choix ("Format", "Niveau recherché") -->
    <style name="TextAppearance.FootTogether.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Petite étiquette colorée sur les cartes (niveau, Complet, Annulé, Terminé) -->
    <style name="Widget.FootTogether.SmallChip" parent="">
        <item name="android:background">@drawable/bg_chip_small</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <!-- Forme ronde pour le bouton central "+" -->
    <style name="ShapeAppearance.FootTogether.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Carte de match : coins 18dp, bordure fine, sans ombre -->
    <style name="Widget.FootTogether.MatchCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>
